# ------------------------------------------------------------------
# RoadmapGenerator - Variables de entorno para SMTP (SEC-01 / SEC-02)
# Copiar este archivo como .env y completar con valores reales.
# NO subir .env al repositorio.
# ------------------------------------------------------------------

# 0 = no exige SMTP (modo local)
# 1 = exige configuracion SMTP completa (modo productivo)
ROADMAP_REQUIRE_SMTP=0

ROADMAP_SMTP_HOST=smtp.gmail.com
ROADMAP_SMTP_PORT=587
ROADMAP_SMTP_USER=tu_cuenta_gmail@gmail.com
# Usar App Password de Gmail (no la clave normal de la cuenta)
ROADMAP_SMTP_PASSWORD=REEMPLAZAR_CON_APP_PASSWORD
ROADMAP_SMTP_FROM=tu_cuenta_gmail@gmail.com
# Opcional (CLI). En la interfaz Streamlit se usa el correo capturado en "Datos de empresa".
ROADMAP_SMTP_TO=

# Opcional. Destinatario interno para CSV estadistico anonimo de investigacion.
# Si se deja vacio, se usa ROADMAP_SMTP_USER. No se envia a la empresa evaluada.
ROADMAP_STATS_TO=
